rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }
    function esAnfitrion() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'anfitrion';
    }
    // HU06
    function esSocioActivo() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'socio_activo';
    }
    function tecnicaValida(t) {
      return t in ['oleo', 'acrilico', 'acuarela', 'tecnica_mixta', 'dibujo',
                   'grabado', 'escultura', 'fotografia', 'ceramica', 'textil'];
    }
    function medidaValida(m) {
      return m is number && m > 0 && m <= 1000;
    }

    // Sprint 1 + HU02: cada uno lee su documento; al registrarse solo puede ser postulante
    match /usuarios/{uid} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid) && request.resource.data.rol == 'postulante';
      allow update, delete: if false; // el cambio de rol lo hace la Cloud Function (HU04)
    }

    // HU02: un documento por DNI para que no se repita
    match /dnis/{dni} {
      allow get: if autenticado();
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // HU02 (crear), HU03 (verificar) y HU04 (leer el Anfitrión; resolver lo hace la Cloud Function)
    match /postulaciones/{uid} {
      allow read: if esDueno(uid) || esAnfitrion();
      allow create: if esDueno(uid)
        && request.resource.data.estado == 'pendiente_verificacion'
        && getAfter(/databases/$(database)/documents/dnis/$(request.resource.data.dni)).data.uid == uid;
      allow update: if esDueno(uid)
        && resource.data.estado == 'pendiente_verificacion'
        && request.resource.data.estado in ['verificada', 'observada']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'motivo', 'fechaVerificacion']);
      allow delete: if false;
    }

    // HU04 y HU05: lo crea la Cloud Function; el socio solo lo lee
    match /socios/{uid} {
      allow read: if esDueno(uid) || esAnfitrion();
      allow write: if false;
    }
    // HU04: contador del número de socio (SOC-0001); solo lo usa la Cloud Function
    match /contadores/{id} {
      allow read, write: if false;
    }

    // HU06: el worker crea la solicitud enviada junto con sus obras (un batch).
    // resource == null deja preguntar si existe una que todavía no se creó (reintentos del worker).
    // La HU07 la cambiará con una Cloud Function, por eso update y delete están cerrados.
    match /solicitudes/{id} {
      allow read: if autenticado()
        && (resource == null || resource.data.uid == request.auth.uid || esAnfitrion());
      allow create: if esSocioActivo()
        && request.resource.data.id == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'enviada'
        && request.resource.data.cantidadObras is int
        && request.resource.data.cantidadObras >= 1
        && request.resource.data.cantidadObras <= 10;
      allow update, delete: if false;
    }
    // HU08: el Especialista de Arte lee las obras que tienen su uid en expertoUid.
    // Su consulta debe llevar whereEqualTo("expertoUid", uid): si no, Firestore la rechaza.
    match /obras/{id} {
      allow read: if autenticado()
        && (resource == null || resource.data.uid == request.auth.uid || esAnfitrion()
            || resource.data.expertoUid == request.auth.uid);
      allow create: if esSocioActivo()
        && request.resource.data.id == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'enviada'
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 1
        && request.resource.data.titulo.size() <= 80
        && tecnicaValida(request.resource.data.tecnica)
        && medidaValida(request.resource.data.altoCm)
        && medidaValida(request.resource.data.anchoCm)
        && (request.resource.data.profundidadCm == null || medidaValida(request.resource.data.profundidadCm))
        && request.resource.data.fotoUrl is string
        && getAfter(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }
        // HU07: Expertos (Especialistas de Arte). Los crea el script sembrarExpertos; la carga la cambia
        // la Cloud Function al aprobar (Parte 2). El Anfitrión los lee para elegir; cada Experto, el suyo.
        match /expertos/{uid} {
          allow read: if esAnfitrion() || esDueno(uid);
          allow write: if false;
        }
        // HU07: embeddings de Expertos y obras. Solo los usa la función analizarSolicitud (admin).
        match /expertos_ia/{id} {
          allow read, write: if false;
        }
        match /obras_ia/{id} {
          allow read, write: if false;
        }
        // HU07 · Parte 2: token de notificaciones (FCM) de cada usuario. Solo el dueño lo escribe;
        // la Cloud Function decidirSolicitud lo lee con permisos de administrador.
        match /tokens/{uid} {
          allow read, write: if esDueno(uid);
        }

  }
}