rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // HU07: Storage consulta Firestore (rol del usuario y estado de la solicitud)
    function esAnfitrion() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'anfitrion';
    }

    // HU06: foto de cada obra en obras/{uid}/{idObra}.jpg; solo el dueño la sube y nadie la borra
    match /obras/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // HU07 · Parte 2: documento por duplicado en documentos/{solicitudId}/archivo.pdf y artista.pdf.
    // El Anfitrión lo sube antes de decidir (la solicitud sigue "enviada") y lo lee siempre.
    // El socio solo lee su copia (artista.pdf), de su solicitud y cuando ya está resuelta.
    match /documentos/{solicitudId}/{archivo} {
      function solicitud() {
        return firestore.get(/databases/(default)/documents/solicitudes/$(solicitudId)).data;
      }
      allow read: if esAnfitrion()
        || (request.auth != null
            && archivo == 'artista.pdf'
            && solicitud().uid == request.auth.uid
            && solicitud().estado in ['aprobada', 'rechazada']);
      allow write: if esAnfitrion()
        && archivo in ['archivo.pdf', 'artista.pdf']
        && solicitud().estado == 'enviada'
        && request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // HU09: documento de rechazo de cada obra en documentos_obras/{obraId}/archivo.pdf y artista.pdf.
    // Solo consulta 2 documentos de Firestore (el límite): usuarios/{uid} y obras/{obraId}.
    // Escribe el Especialista de la obra mientras sigue "en_evaluacion" (antes de registrar el veredicto).
    // Leen el Anfitrión, el Gerente y el Especialista de la obra; el socio, solo artista.pdf de su obra rechazada.
    match /documentos_obras/{obraId}/{archivo} {
      function obra() {
        return firestore.get(/databases/(default)/documents/obras/$(obraId)).data;
      }
      function rol() {
        return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol;
      }
      allow read: if request.auth != null
        && (rol() in ['anfitrion', 'gerente']
            || obra().expertoUid == request.auth.uid
            || (archivo == 'artista.pdf'
                && obra().uid == request.auth.uid
                && obra().estado == 'rechazada'));
      allow write: if request.auth != null
        && archivo in ['archivo.pdf', 'artista.pdf']
        && obra().expertoUid == request.auth.uid
        && obra().estado == 'en_evaluacion'
        && request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // HU10: documento de venta de cada obra en documentos_venta/{obraId}/archivo.pdf y artista.pdf.
    // Solo consulta 2 documentos de Firestore (el límite): usuarios/{uid} y obras/{obraId}.
    // Escribe el Especialista de Ventas mientras la obra sigue "aceptada" (antes de registrar la tasación).
    // Lee el Especialista de Ventas; el socio, solo artista.pdf de su obra lista para exhibición.
    match /documentos_venta/{obraId}/{archivo} {
      function obra() {
        return firestore.get(/databases/(default)/documents/obras/$(obraId)).data;
      }
      function rol() {
        return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol;
      }
      allow read: if request.auth != null
        && (rol() == 'especialista_ventas'
            || (archivo == 'artista.pdf'
                && obra().uid == request.auth.uid
                && obra().estado == 'lista_exhibicion'));
      allow write: if request.auth != null
        && rol() == 'especialista_ventas'
        && archivo in ['archivo.pdf', 'artista.pdf']
        && obra().estado == 'aceptada'
        && request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

  }
}